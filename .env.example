# Client: blank uses same-origin /online. Vite development proxies to port 8787.
# A different public WS server may be configured at client build time:
VITE_MULTIPLAYER_URL=

# Persistent Node server (Node 24). Copy this file to .env for server:start.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./server-data/skytopia.sqlite
# Production requires APP_ORIGIN (HTTPS) or APP_DOMAIN. No domain is hardcoded.
APP_ORIGIN=http://127.0.0.1:5188
APP_DOMAIN=
# Optional additional exact origins, comma-separated. No wildcard.
ALLOWED_ORIGINS=
# Optional long random secret; /metrics is inaccessible without it.
ADMIN_TOKEN=
